# Copy to .env for local runs. On a host, set these as secrets/env vars.

# --- Switches ---
DEMO_ENABLED=true                     # false = kill switch; the site falls back to the recorded run
ALLOWED_ORIGINS=http://localhost:4321 # comma-separated site origins, e.g. https://phli.com,https://www.phli.com
TRUST_PROXY=false                     # true behind Fly/Railway/Render so the real client IP is used
PORT=8787

# --- Model backend: fake | openai | anthropic ---
LLM_PROVIDER=fake

# Local / self-hosted (any OpenAI-compatible server)
#   Ollama:    OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=qwen3:8b  (or gemma3:12b etc.)
#   llama.cpp: OPENAI_BASE_URL=http://localhost:8080/v1    OPENAI_MODEL=qwen3.5-4b
#   vLLM:      OPENAI_BASE_URL=http://gpu-host:8000/v1     OPENAI_MODEL=Qwen/Qwen3-8B
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_MODEL=qwen3:8b
OPENAI_API_KEY=

# Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5       # or claude-sonnet-5-5 / claude-haiku-5-5 to cut cost
ANTHROPIC_EFFORT=medium

# --- Limits ---
SESSIONS_PER_IP_PER_HOUR=3
MAX_CONCURRENT_SESSIONS=5
DAILY_SESSION_CAP=300
DAILY_BUDGET_USD=5                    # counts Claude spend only; local models cost 0 here
MAX_TOOL_CALLS=15
MAX_MODEL_TURNS=12
SESSION_TTL_MS=900000
APPROVAL_TIMEOUT_MS=300000
MODEL_TIMEOUT_MS=60000
