---
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
---
<span class="logo" aria-label="Phli">
  <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true">
    <rect width="28" height="28" rx="6" fill={dark ? '#f26b1d' : '#15181d'} />
    <path d="M8 19 L14 9 L20 19" fill="none" stroke={dark ? '#15181d' : '#f26b1d'} stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="14" cy="20.5" r="1.9" fill={dark ? '#15181d' : '#ffffff'} />
  </svg>
  <span class="word">Phli</span>
</span>
<style>
  .logo { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-en); font-weight: 600; font-size: 1.2rem; letter-spacing: -0.01em; }
</style>
